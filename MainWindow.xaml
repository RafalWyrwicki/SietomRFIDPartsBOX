<Window x:Class="PartsBox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SIETOM RFID PartsBOX" Icon="Assets/sietom.ico" Width="1280" Height="800" MinWidth="1024" MinHeight="700" Background="#F7F7F7" FontFamily="Segoe UI" FontSize="16" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="V"/><Style TargetType="ScrollBar"><Style.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="28"/></Trigger><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="28"/></Trigger></Style.Triggers></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#303030"/><Setter Property="BorderBrush" Value="#6C6C6C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="26,12"/><Setter Property="MinHeight" Value="48"/><Setter Property="MinWidth" Value="138"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3B3B3A"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderBrush" Value="#D1D1D1"/><Setter Property="Padding" Value="26"/><Setter Property="MinHeight" Value="134"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#D0D0D0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0"/></Style>
  <Style TargetType="DatePicker">
   <Style.Resources>
    <Style TargetType="Button"><Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="DatePickerTextBox"><Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
   </Style.Resources>
   <Setter Property="FontSize" Value="16"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D0D0D0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Language" Value="pl-PL"/><Setter Property="SelectedDateFormat" Value="Short"/>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="58"/><Setter Property="ColumnHeaderHeight" Value="46"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#666666"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#ECECEC"/><Setter Property="Foreground" Value="#252525"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Sheet" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D2D2D2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="72"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Background="#3B3B3A" Padding="28,10"><DockPanel><Button x:Name="CloseButton" Content="Zamknij" Click="CloseButton_Click" DockPanel.Dock="Right" MinWidth="100" MinHeight="38" Padding="16,6" Margin="20,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding HeaderRight}" DockPanel.Dock="Right" Foreground="#EEEEEE" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Header}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EmployeeDetails}" Foreground="#EEEEEE" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding MenuPage,Converter={StaticResource V}}"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Visibility="{Binding LoginPage,Converter={StaticResource V}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="510">
   <TextBlock Text="Przyłóż kartę pracowniczą" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,28"/>
   <Border Style="{StaticResource Sheet}" Width="220" Height="205" HorizontalAlignment="Center" Margin="0,0,0,22"><Viewbox Width="108" Height="118"><Canvas Width="108" Height="118"><Rectangle Canvas.Left="14" Canvas.Top="12" Width="72" Height="96" RadiusX="6" RadiusY="6" Stroke="#414141" StrokeThickness="5"/><Rectangle Canvas.Left="27" Canvas.Top="28" Width="46" Height="13" Fill="#414141"/><Path Data="M 82,60 C 105,63 111,91 86,102" Stroke="#414141" StrokeThickness="4"/></Canvas></Viewbox></Border>
   <TextBlock Text="Logowanie nastąpi automatycznie po odczytaniu karty." Foreground="#777777" TextWrapping="Wrap" TextAlignment="Center"/>
  </StackPanel></Grid>
  <Grid Grid.Row="1" Margin="38,32,38,24" Visibility="{Binding MenuPage,Converter={StaticResource V}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Wybierz operację" Style="{StaticResource Heading}"/>
   <Grid Grid.Row="1" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Style="{StaticResource Tile}" Command="{Binding IssuePageCommand}" Margin="0,0,14,20"><StackPanel><TextBlock Text="Pobierz części" FontSize="23" FontWeight="Bold"/><TextBlock Text="Wybierz zlecenie i rozpocznij odczyt" Foreground="#777777" FontWeight="Normal" Margin="0,14,0,0"/></StackPanel></Button>
    <Button Grid.Column="1" Style="{StaticResource Tile}" Command="{Binding ReturnPageCommand}" Margin="14,0,0,20"><StackPanel><TextBlock Text="Oddaj części" FontSize="23" FontWeight="Bold"/><TextBlock Text="Zarejestruj zwrot niewykorzystanych części" Foreground="#777777" FontWeight="Normal" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Button>
    <Button Grid.Row="1" Style="{StaticResource Tile}" Command="{Binding InventoryPageCommand}" Margin="0,0,14,0"><StackPanel><TextBlock Text="Kontrola stanów magazynowych" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="Zlicz elementy w kuwecie" Foreground="#777777" FontWeight="Normal" Margin="0,14,0,0"/></StackPanel></Button>
    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" Command="{Binding ReportsPageCommand}" Margin="14,0,0,0"><StackPanel><TextBlock Text="Raporty" FontSize="23" FontWeight="Bold"/><TextBlock Text="Przeglądaj i eksportuj dane" Foreground="#777777" FontWeight="Normal" Margin="0,14,0,0"/></StackPanel></Button>
   </Grid><DockPanel Grid.Row="2" Margin="0,24,0,0"><Button Content="Wyloguj" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Import zleceń XLSX" Command="{Binding ImportOrdersCommand}" Margin="12,0,0,0"/><Button Content="Import magazynu CSV" Command="{Binding ImportStockCommand}" Margin="12,0,0,0"/></StackPanel></DockPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="38,30,38,24" Visibility="{Binding OrdersPage,Converter={StaticResource V}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Dostępne zlecenia" Style="{StaticResource Heading}"/><DockPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock Text="Szukaj zlecenia" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox DockPanel.Dock="Right" Width="260" ItemsSource="{Binding OrderLocations}" SelectedItem="{Binding OrderLocation}" ToolTip="Lokalizacja funkcjonalna" Margin="12,0,0,0"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Numer, opis zadania, urządzenie lub lokalizacja"/></DockPanel>
   <Border Grid.Row="2" Style="{StaticResource Sheet}"><DataGrid ItemsSource="{Binding FilteredOrders}" SelectedItem="{Binding SelectedOrder}" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.PanningMode="Both" VirtualizingPanel.ScrollUnit="Pixel"><DataGrid.Columns><DataGridTextColumn Header="Data wprowadzenia" Binding="{Binding CreatedDate,StringFormat=dd.MM.yyyy}" Width="175"/><DataGridTextColumn Header="Zlecenie" Binding="{Binding Number}" Width="155"/><DataGridTextColumn Header="Status użytkownika" Binding="{Binding UserStatus}" Width="180"/><DataGridTextColumn Header="Urządzenie" Binding="{Binding Equipment}" Width="150"/><DataGridTextColumn Header="Krótki tekst" Binding="{Binding Description}" Width="380"/><DataGridTextColumn Header="Oznaczenie obiektu technicznego" Binding="{Binding EquipmentDescription}" Width="350"/><DataGridTextColumn Header="Oznaczenie lokalizacji funkcjonalnej" Binding="{Binding LocationDescription}" Width="350"/><DataGridTextColumn Header="Lokalizacja funkcjonalna" Binding="{Binding FunctionalLocation}" Width="270"/></DataGrid.Columns></DataGrid></Border>
   <DockPanel Grid.Row="3" Margin="0,24,0,0"><Button Content="Wróć" Command="{Binding BackCommand}" HorizontalAlignment="Left"/><Button Content="Wybierz zlecenie" Command="{Binding SelectOrderCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="38,30,38,24" Visibility="{Binding ReturnsPage,Converter={StaticResource V}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Wybierz pierwotne pobranie" Style="{StaticResource Heading}"/><DockPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock Text="Szukaj zlecenia" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBox Text="{Binding ReturnSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Numer zlecenia"/></DockPanel>
   <Border Grid.Row="2" Style="{StaticResource Sheet}"><DataGrid ItemsSource="{Binding FilteredReceipts}" SelectedItem="{Binding SelectedReceipt}"><DataGrid.Columns><DataGridTextColumn Header="Zlecenie" Binding="{Binding Order}" Width="220"/><DataGridTextColumn Header="Data pobrania" Binding="{Binding Date,StringFormat=dd.MM.yyyy HH:mm}" Width="230"/><DataGridTextColumn Header="Identyfikator pobrania" Binding="{Binding Id}" Width="*"/></DataGrid.Columns></DataGrid></Border>
   <DockPanel Grid.Row="3" Margin="0,24,0,0"><Button Content="Wróć" Command="{Binding BackCommand}" HorizontalAlignment="Left"/><Button Content="Rozpocznij zwrot" Command="{Binding SelectReturnCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="38,28,38,24" Visibility="{Binding ScanPage,Converter={StaticResource V}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding ScanTitle}" Style="{StaticResource Heading}"/>
   <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="{Binding ErrorColumnWidth}"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Sheet}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Unikalne EPC" Foreground="#777777" FontSize="13"/><TextBlock Text="{Binding TagCount}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Sheet}" Margin="0,0,20,0" Visibility="{Binding ShowScanErrors,Converter={StaticResource V}}"><StackPanel><TextBlock Text="Błędy" Foreground="#777777" FontSize="13"/><TextBlock Text="{Binding ErrorCount}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Sheet}" Background="#EEEEEE" BorderBrush="#777777"><TextBlock Text="{Binding ScanState}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></Border>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource Sheet}"><DataGrid ItemsSource="{Binding Rows}"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Nieznany EPC"><Setter Property="Background" Value="#ECECEC"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="155"/><DataGridTextColumn Header="EPC" Binding="{Binding EPC}" Width="265"/><DataGridTextColumn Header="Indeks SAP" Binding="{Binding Indeks}" Width="140"/><DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*"/><DataGridTemplateColumn Header="Ilość" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="1"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
   <DockPanel Grid.Row="4" Margin="0,22,0,0" LastChildFill="True"><Button DockPanel.Dock="Right" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,0"/><WrapPanel><Button Content="Wróć do menu" Command="{Binding InventoryBackCommand}" Visibility="{Binding InventoryScanPage,Converter={StaticResource V}}" ToolTip="Powrót po zapisaniu kontroli lub wyczyszczeniu odczytów." Margin="0,0,12,8"/><Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,12,0"/><Button Content="Wyczyść" Command="{Binding ClearCommand}" Margin="0,0,12,0"/><Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,12,0"/><Button Content="Stop" Command="{Binding StopCommand}"/></WrapPanel></DockPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="38,30,38,24" Visibility="{Binding ReportsPage,Converter={StaticResource V}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Filtry raportu" Style="{StaticResource Heading}"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Typ raportu" Foreground="#777777" FontSize="13" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding ReportType}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="Data od" Foreground="#777777" FontSize="13" Margin="0,0,0,8"/><DatePicker SelectedDate="{Binding From}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,18,0"><TextBlock Text="Data do" Foreground="#777777" FontSize="13" Margin="0,0,0,8"/><DatePicker SelectedDate="{Binding Until}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Pracownik" Foreground="#777777" FontSize="13" Margin="0,0,0,8"/><TextBox Text="Moje operacje" IsReadOnly="True"/></StackPanel></Grid>
   <Button Grid.Row="2" Content="Filtruj" Command="{Binding RefreshCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,16,0,22"/>
   <Border Grid.Row="3" Style="{StaticResource Sheet}"><DataGrid ItemsSource="{Binding DisplayHistory}"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Data,StringFormat=dd.MM HH:mm}" Width="125" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Pracownik" Binding="{Binding Pracownik}" Width="200" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Zlecenie" Binding="{Binding Zlecenie}" Width="135" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="EPC" Binding="{Binding EPC}" Width="245" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Status SAP / rozliczenie" Binding="{Binding Rozliczenie}" Width="*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></Border>
   <DockPanel Grid.Row="4" Margin="0,24,0,0"><Button Content="Wróć" Command="{Binding BackCommand}" HorizontalAlignment="Left"/><Button Content="Eksport Excel / CSV" Command="{Binding ExportCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
  <StackPanel Grid.Row="2"><Border Background="#FFF0ED" BorderBrush="#B84032" BorderThickness="1" CornerRadius="6" Padding="14" Margin="28,4,28,8" Visibility="{Binding ConnectionProblem,Converter={StaticResource V}}"><DockPanel><Button Content="Ponów połączenie" DockPanel.Dock="Right" Command="{Binding ReconnectCommand}" Margin="16,0,0,0"/><TextBlock Text="{Binding ConnectionMessage}" Foreground="#8C241C" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border><TextBlock Text="{Binding Message}" Margin="28,4,28,10" FontSize="13" Foreground="#666666" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="3" Background="#303030" Padding="26,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{Binding RfidColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding RfidShort}" Foreground="White" FontSize="12" Margin="0,0,28,0"/><Ellipse Width="8" Height="8" Fill="{Binding SqlColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding Sql}" Foreground="White" FontSize="12" Margin="0,0,28,0"/><Ellipse Width="8" Height="8" Fill="{Binding SapColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding SapStatus}" Foreground="White" FontSize="12" Margin="0,0,28,0"/><Ellipse Width="8" Height="8" Fill="{Binding CardColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding CardStatus}" Foreground="White" FontSize="12"/></StackPanel></Border>
  <Grid Grid.RowSpan="4" Background="#88000000" Visibility="{Binding CancelVisible,Converter={StaticResource V}}" Panel.ZIndex="100"><Border Background="White" CornerRadius="10" Width="490" Padding="36" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel><TextBlock Text="Anulować operację?" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Odczyt zostanie zatrzymany." Foreground="#777777" HorizontalAlignment="Center" Margin="0,24,0,8"/><TextBlock Text="Wrócisz do menu bez zapisywania operacji." Foreground="#777777" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0"><Button Content="Wróć" Command="{Binding DismissCancelCommand}" Margin="0,0,16,0"/><Button Content="Anuluj operację" Command="{Binding AcceptCancelCommand}" Style="{StaticResource Primary}"/></StackPanel></StackPanel></Border></Grid>
 </Grid>
</Window>






