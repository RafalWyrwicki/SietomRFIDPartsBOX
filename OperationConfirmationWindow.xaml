<Window x:Class="PartsBox.OperationConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
 FontFamily="Segoe UI" FontSize="16" Foreground="#303030">
 <Border BorderBrush="#D2D2D2" BorderThickness="1" KeyboardNavigation.TabNavigation="Cycle">
  <StackPanel>
   <Border Background="#303030" Padding="28,20"><TextBlock Text="RFID PartBOX" Foreground="White" FontSize="18" FontWeight="SemiBold"/></Border>
   <StackPanel Margin="32">
    <Border Background="#EAF6EC" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Left">
     <Path Data="M 0,10 L 8,18 L 24,0" Stroke="#28763C" StrokeThickness="4" Width="26" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold" Margin="0,20,0,8" TextWrapping="Wrap"/>
    <TextBlock Text="Operacja została zapisana pomyślnie." Foreground="#666666" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Margin="0,22,0,18">
     <TextBlock x:Name="Quantity" FontSize="44" FontWeight="Bold" Foreground="#28763C"/>
     <TextBlock Text="szt." FontSize="20" VerticalAlignment="Bottom" Margin="10,0,0,8"/>
    </StackPanel>
    <TextBlock x:Name="Details" Foreground="#666666" TextWrapping="Wrap" LineHeight="24"/>
    <Button x:Name="Done" Content="OK, zakończ" IsDefault="True" IsCancel="True" Click="Done_Click"
     Margin="0,28,0,0" Padding="24,14" FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#3B3B3A" Cursor="Hand">
     <Button.Template><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderBrush="#777777" BorderThickness="1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#505050"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#87B995"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
    </Button>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
